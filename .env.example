# ============================================================
# Classio Platform — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to source control.
# ============================================================

# --- Supabase (Public — safe to expose in browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Supabase (Server-only — NEVER expose to browser) ---
# Used by server API routes with service role for admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Admin Auth (Server-only — NEVER use NEXT_PUBLIC_ here) ---
# Set these in Vercel > Project Settings > Environment Variables
# They are ONLY read server-side and never sent to the browser bundle.
CLASSIO_ADMIN_EMAIL=your-admin-email@classio.app
CLASSIO_ADMIN_PASSWORD=your-very-strong-password-here
CLASSIO_ADMIN_PIN=123456
CLASSIO_ADMIN_FORTRESS_KEY=your-secret-fortress-key-here

# --- App Config ---
NEXT_PUBLIC_DEFAULT_CURRENCY=EGP
NEXT_PUBLIC_COUNTRY_CODE=20
